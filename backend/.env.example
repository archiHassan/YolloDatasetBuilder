# Environment Configuration Template
# Copy this file to .env and fill in the values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment: development, staging, production
APP_ENV=production

# Application name
APP_NAME="YOLO Dataset Builder"

# Debug mode (set to false in production)
DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# SERVER SETTINGS
# =============================================================================

# Host to bind to (0.0.0.0 for Docker, 127.0.0.1 for local)
HOST=0.0.0.0

# Port to run the application on
PORT=8000

# Number of worker processes (2-4 x CPU cores)
WORKERS=4

# =============================================================================
# CORS SETTINGS
# =============================================================================

# Allowed origins (comma-separated)
# Example: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Allow credentials
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# DATABASE SETTINGS
# =============================================================================

# Database file path (relative to backend directory)
DATABASE_URL=../data/annotations.db

# Enable foreign key constraints
DB_FOREIGN_KEYS=true

# Connection pool size (for SQLite, this is mostly symbolic)
DB_POOL_SIZE=5

# =============================================================================
# FILE STORAGE SETTINGS
# =============================================================================

# Images directory (relative to backend directory)
IMAGES_DIR=../data/images

# Maximum upload file size (in bytes, default 50MB)
MAX_UPLOAD_SIZE=52428800

# Allowed image formats (comma-separated)
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,bmp,tiff

# Temporary export directory
EXPORT_DIR=../data/exports

# =============================================================================
# SAM (Segment Anything Model) SETTINGS
# =============================================================================

# SAM mode: mock, local, api
# - mock: Use mock SAM (generates circles for testing)
# - local: Use local SAM model (requires model weights)
# - api: Use external SAM API (Replicate, HuggingFace)
SAM_MODE=mock

# SAM model weights path (only for local mode)
# Download from: https://github.com/facebookresearch/segment-anything#model-checkpoints
SAM_MODEL_PATH=../models/sam_vit_h_4b8939.pth

# SAM model variant: vit_h, vit_l, vit_b
SAM_MODEL_VARIANT=vit_h

# SAM API settings (only for api mode)
SAM_API_URL=https://api.replicate.com/v1/predictions
SAM_API_KEY=your_replicate_api_key_here

# SAM timeout (seconds)
SAM_TIMEOUT=30

# =============================================================================
# AI MODELS SETTINGS (Optional)
# =============================================================================

# Models directory
MODELS_DIR=../models

# YOLOv8 model path (optional, for auto-annotation)
YOLO_MODEL_PATH=../models/yolov8n.pt

# DETR model name (HuggingFace)
DETR_MODEL_NAME=facebook/detr-resnet-50

# Confidence threshold for auto-annotation
CONFIDENCE_THRESHOLD=0.5

# Enable GPU acceleration (if available)
USE_GPU=false

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# JWT secret key (generate with: openssl rand -hex 32)
# IMPORTANT: Change this in production!
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# JWT algorithm
JWT_ALGORITHM=HS256

# JWT expiration time (in minutes)
JWT_EXPIRATION_MINUTES=60

# Enable authentication (set to true for multi-user mode)
ENABLE_AUTH=false

# Password hashing rounds (bcrypt)
PASSWORD_HASH_ROUNDS=12

# Rate limiting (requests per minute per IP)
RATE_LIMIT=100

# =============================================================================
# EXPORT SETTINGS
# =============================================================================

# Default export format: coco, yolo, voc
DEFAULT_EXPORT_FORMAT=coco

# Include unapproved annotations in export
EXPORT_INCLUDE_UNAPPROVED=false

# Export ZIP compression level (0-9, 9 is maximum compression)
EXPORT_COMPRESSION_LEVEL=6

# =============================================================================
# BACKUP SETTINGS
# =============================================================================

# Backup directory
BACKUP_DIR=../data/backups

# Backup retention days
BACKUP_RETENTION_DAYS=7

# Enable automatic backups
AUTO_BACKUP_ENABLED=true

# Backup schedule (cron format, daily at 2 AM)
BACKUP_SCHEDULE=0 2 * * *

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

# Enable Sentry error tracking
SENTRY_ENABLED=false
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Enable Prometheus metrics
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Log file path
LOG_FILE_PATH=../logs/app.log

# Log rotation (days)
LOG_ROTATION_DAYS=30

# =============================================================================
# EMAIL SETTINGS (Optional, for notifications)
# =============================================================================

# SMTP server settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@yourdomain.com

# Enable email notifications
EMAIL_NOTIFICATIONS_ENABLED=false

# =============================================================================
# CLOUD STORAGE (Optional, for S3/Cloud Storage)
# =============================================================================

# Cloud storage provider: s3, gcs, azure
CLOUD_STORAGE_PROVIDER=none

# AWS S3 settings
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1

# Google Cloud Storage settings
GCS_BUCKET=your-gcs-bucket
GCS_PROJECT_ID=your-project-id
GCS_CREDENTIALS_PATH=../credentials/gcs-key.json

# Azure Blob Storage settings
AZURE_STORAGE_CONNECTION_STRING=your-connection-string
AZURE_CONTAINER_NAME=your-container-name

# =============================================================================
# REDIS SETTINGS (Optional, for caching and task queue)
# =============================================================================

# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# Enable Redis caching
REDIS_CACHE_ENABLED=false

# Cache TTL (seconds)
REDIS_CACHE_TTL=3600

# =============================================================================
# CELERY SETTINGS (Optional, for async task processing)
# =============================================================================

# Celery broker URL (Redis or RabbitMQ)
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Enable Celery for background tasks
CELERY_ENABLED=false

# =============================================================================
# DEVELOPMENT SETTINGS (Only for development environment)
# =============================================================================

# Enable hot reload
HOT_RELOAD=false

# Show detailed error pages
SHOW_ERROR_DETAILS=false

# Enable SQL query logging
LOG_SQL_QUERIES=false

# =============================================================================
# NOTES
# =============================================================================

# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in the values appropriate for your environment
# 3. NEVER commit .env to version control
# 4. For production, ensure all secrets are changed from defaults
# 5. Use strong, randomly generated values for JWT_SECRET_KEY
# 6. Set DEBUG=false and LOG_LEVEL=INFO for production
# 7. Configure CORS_ORIGINS to match your production domain
# 8. Enable HTTPS in production
# 9. Configure backups and monitoring for production
# 10. Review security settings before going live
